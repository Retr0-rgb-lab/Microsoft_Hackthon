            "source_commit": {
              "type": "string"
            },
            "dataset_version": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "snapshot_source": {
              "const": "generator_decisions"
            },
            "match_excluded_from_fitting": {
              "const": true
            }
          },
          "required": [
            "dataset",
            "root",
            "source_commit",
            "dataset_version",
            "model_id",
            "snapshot_source",
            "match_excluded_from_fitting"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "snapshot",
        "metadata",
        "request",
        "source_profile",
