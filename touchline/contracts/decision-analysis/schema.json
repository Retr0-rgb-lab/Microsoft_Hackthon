                "speed_mps": {
                  "type": "number"
                },
                "speed_kmh": {
                  "type": "number"
                },
                "movement_heading_deg": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "movement_label": {
                  "type": "string"
                },
                "nearest_opponent": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "player_id": {
                          "type": "string"
                        },
                        "distance_m": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "player_id",
                        "distance_m"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
