            "temperature": {
              "type": [
                "number",
                "null"
              ]
            },
            "feature_units": {
              "type": "object",
              "properties": {
                "progress": {
                  "type": "string"
                },
                "y": {
                  "type": "string"
                },
                "vx": {
                  "type": "string"
                },
                "vy": {
                  "type": "string"
                },
                "ball_speed": {
                  "type": "string"
                },
                "distance": {
                  "type": "string"
                },
                "advance": {
                  "type": "string"
                },
                "lateral": {
                  "type": "string"
                },
                "duration": {
                  "type": "string"
                },
                "source_pressure": {
                  "type": "string"
                },
                "receiver_pressure": {
                  "type": "string"
                },
                "nearest_defender": {
                  "type": "string"
                },
                "closing_speed": {
                  "type": "string"
                },
                "lane_pressure": {
                  "type": "string"
                },
                "intercept_margin": {
                  "type": "string"
                },
                "goal_distance": {
                  "type": "string"
                },
                "goal_angle": {
                  "type": "string"
                },
                "blockers": {
                  "type": "string"
                },
                "keeper_offset": {
                  "type": "string"
                },
                "target_speed": {
                  "type": "string"
                },
                "attack_ratio": {
                  "type": "string"
                },
                "passing_ratio": {
                  "type": "string"
                },
                "time_fraction": {
                  "type": "string"
                },
                "score_difference": {
                  "type": "string"
                },
                "player_difference": {
                  "type": "string"
                },
                "receiver_nearest_defender": {
                  "type": "string"
                },
                "receiver_reachable": {
                  "type": "string"
                },
                "keeper_depth": {
                  "type": "string"
                },
                "keeper_cover": {
                  "type": "string"
                },
                "state_quality": {
                  "type": "string"
                }
