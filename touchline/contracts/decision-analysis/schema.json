{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nextplay:decision-analysis:1.0.0",
  "title": "Decision analysis diagnostics and counterfactual extension",
  "$defs": {
    "analysis_request": {
      "$ref": "urn:nextplay:contracts:1.0.0#/$defs/analysis_request"
    },
