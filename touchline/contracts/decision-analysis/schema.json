                    },
                    "required": [
                      "goal",
                      "blocked",
                      "saved",
                      "off_target"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "q2": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "q1": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "softmax_weight": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "relative_score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "value_gap": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "decomposition": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "immediate": {
                        "type": "number"
                      },
                      "continuation": {
                        "type": "number"
                      },
                      "risk": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "immediate",
                      "continuation",
                      "risk"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "judgment": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "risk": {
                    "type": "string"
                  },
                  "assumptions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "similar_to_best": {
                    "type": "boolean"
                  },
                  "comparison_tolerance": {
                    "type": "number"
                  },
                  "counterfactual_available": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "reason",
                  "risk",
                  "assumptions",
                  "evidence_ids",
                  "similar_to_best",
                  "comparison_tolerance",
                  "counterfactual_available"
                ],
                "additionalProperties": false
              }
