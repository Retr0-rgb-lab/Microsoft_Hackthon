                      "progress",
                      "y",
                      "vx",
                      "vy",
                      "ball_speed",
                      "distance",
                      "advance",
                      "lateral",
                      "duration",
                      "source_pressure",
                      "receiver_pressure",
                      "nearest_defender",
                      "closing_speed",
                      "lane_pressure",
                      "intercept_margin",
                      "goal_distance",
                      "goal_angle",
                      "blockers",
                      "keeper_offset",
                      "target_speed",
                      "attack_ratio",
                      "passing_ratio",
                      "time_fraction",
                      "score_difference",
                      "player_difference",
                      "receiver_nearest_defender",
                      "receiver_reachable",
                      "keeper_depth",
                      "keeper_cover",
                      "state_quality"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome_probabilities": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "success": {
                        "type": "number"
                      },
                      "loss": {
                        "type": "number"
                      }
