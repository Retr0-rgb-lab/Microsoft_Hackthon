      "required": [
        "schema_version",
        "match_id",
        "decision_id",
        "snapshot_id",
        "candidate_set_id",
        "data_version",
        "source",
        "snapshot",
        "public",
        "action_conditions",
        "model",
        "candidates",
        "assessment",
        "limitations",
        "request",
        "player_source_profile"
      ],
      "additionalProperties": false
    },
    "counterfactual_request": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "urn:nextplay:contracts:1.0.0#/$defs/analysis_request"
        },
        "candidate_set_id": {
          "type": "string"
        },
        "action_id": {
          "type": "string"
        }
      },
      "required": [
        "request",
        "candidate_set_id",
        "action_id"
      ],
      "additionalProperties": false
    },
    "counterfactual_response": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "decision-counterfactual-1"
        },
        "action_id": {
          "type": "string"
        },
        "kind": {
          "const": "counterfactual"
        },
        "source_t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "horizon_s": {
          "const": 4
        },
        "step_s": {
          "const": 0.05
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "quick",
                  "baseline",
                  "delayed",
                  "wide_error"
                ]
              },
              "reaction_s": {
                "type": "number"
              },
              "lateral_error_m": {
                "type": "number"
              },
              "outcome": {
                "enum": [
                  "received",
                  "intercepted",
                  "unreceived",
                  "unresolved",
                  "retained",
                  "goal",
                  "blocked",
                  "saved",
                  "off_target",
                  "period_end"
                ]
              },
              "controller_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "duration_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 4
              },
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "elapsed_s": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "players": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 5,
                        "maxItems": 5
                      }
                    },
                    "ball": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 6,
                      "maxItems": 6
                    }
                  },
                  "required": [
                    "elapsed_s",
                    "players",
                    "ball"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "reaction_s",
              "lateral_error_m",
              "outcome",
              "controller_id",
              "duration_s",
              "frames"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        },
        "data_version": {
          "type": "string"
        },
        "candidate_set_id": {
          "type": "string"
        },
        "action_type": {
          "enum": [
            "pass",
            "carry",
            "shot"
          ]
        },
        "start": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "template_speed_mps": {
          "type": [
            "number",
            "null"
          ]
        },
        "ranking_unchanged": {
          "const": true
        },
        "not_observed_future": {
          "const": true
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "kind",
        "source_t_ms",
        "horizon_s",
        "step_s",
        "scenarios",
        "assumptions",
        "summary",
        "snapshot_id",
        "data_version",
        "candidate_set_id",
        "action_type",
        "start",
        "target",
        "template_speed_mps",
        "ranking_unchanged",
        "not_observed_future"
      ],
      "additionalProperties": false
    },
    "context_response": {
      "type": "object",
      "properties": {
        "snapshot": {
          "$ref": "urn:nextplay:contracts:1.0.0#/$defs/snapshot"
        },
        "metadata": {
          "$ref": "urn:synthetic-football:records:1.0.0#/$defs/match"
