                    "required": [
                      "success",
                      "loss"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "goal": {
                        "type": "number"
                      },
                      "blocked": {
                        "type": "number"
                      },
                      "saved": {
                        "type": "number"
                      },
                      "off_target": {
                        "type": "number"
