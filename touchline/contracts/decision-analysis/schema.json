                },
                "ball_distance_m": {
                  "type": "number"
                },
                "attacking_direction": {
                  "enum": [
                    "positive_x",
                    "negative_x"
                  ]
                },
                "body_orientation": {
                  "type": "null"
                },
                "provenance": {
                  "type": "string"
