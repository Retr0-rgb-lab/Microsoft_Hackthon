          "additionalProperties": false
        },
        "snapshot": {
          "$ref": "urn:nextplay:contracts:1.0.0#/$defs/snapshot"
        },
        "public": {
          "$ref": "urn:nextplay:contracts:1.0.0#/$defs/analysis_response"
        },
