              "recipient_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "planned_duration_s": {
                "type": "number"
              },
              "mode": {
                "type": "string"
              },
              "features": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "progress": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "vx": {
                        "type": "number"
                      },
                      "vy": {
                        "type": "number"
                      },
                      "ball_speed": {
                        "type": "number"
                      },
                      "distance": {
                        "type": "number"
                      },
                      "advance": {
                        "type": "number"
                      },
                      "lateral": {
                        "type": "number"
                      },
                      "duration": {
                        "type": "number"
                      },
                      "source_pressure": {
                        "type": "number"
                      },
                      "receiver_pressure": {
                        "type": "number"
                      },
                      "nearest_defender": {
                        "type": "number"
                      },
                      "closing_speed": {
                        "type": "number"
                      },
                      "lane_pressure": {
                        "type": "number"
                      },
                      "intercept_margin": {
                        "type": "number"
                      },
                      "goal_distance": {
                        "type": "number"
                      },
                      "goal_angle": {
                        "type": "number"
                      },
                      "blockers": {
                        "type": "number"
                      },
                      "keeper_offset": {
                        "type": "number"
                      },
                      "target_speed": {
                        "type": "number"
                      },
                      "attack_ratio": {
                        "type": "number"
                      },
                      "passing_ratio": {
                        "type": "number"
                      },
                      "time_fraction": {
                        "type": "number"
                      },
                      "score_difference": {
                        "type": "number"
                      },
                      "player_difference": {
                        "type": "number"
                      },
                      "receiver_nearest_defender": {
                        "type": "number"
                      },
                      "receiver_reachable": {
                        "type": "number"
                      },
                      "keeper_depth": {
                        "type": "number"
                      },
                      "keeper_cover": {
                        "type": "number"
                      },
                      "state_quality": {
                        "type": "number"
                      }
