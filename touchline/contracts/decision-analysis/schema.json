            "required": [
              "action_id",
              "type",
              "eligible",
              "rank",
              "recipient_id",
              "target",
              "planned_duration_s",
              "mode",
              "features",
              "outcome_probabilities",
              "q2",
              "q1",
              "softmax_weight",
              "relative_score",
              "value_gap",
              "decomposition",
              "judgment"
            ],
            "additionalProperties": false
          }
        },
        "assessment": {
          "type": "object",
          "properties": {
            "recommended_action_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 0
            },
            "actual_action_included": {
              "const": false
            },
            "similar_value_tolerance": {
              "type": "number"
            },
            "agent_available": {
              "const": false
            }
          },
          "required": [
            "recommended_action_id",
            "candidate_count",
            "actual_action_included",
            "similar_value_tolerance",
            "agent_available"
          ],
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request": {
          "$ref": "urn:nextplay:contracts:1.0.0#/$defs/analysis_request"
        },
        "player_source_profile": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "observation": {
              "type": [
                "object",
                "null"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "used_in_probability": {
              "const": false
