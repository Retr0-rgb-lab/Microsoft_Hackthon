    "index_response": {
      "type": "object",
      "properties": {
        "match_id": {
          "type": "string"
        },
        "data_version": {
          "type": "string"
        },
        "identification": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "properties": {
            "decisions": {
              "type": "integer",
              "minimum": 0
            },
            "covered": {
              "type": "integer",
