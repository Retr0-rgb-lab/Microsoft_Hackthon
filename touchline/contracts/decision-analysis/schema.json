        "schema_version": {
          "const": "decision-analysis-1"
        },
        "match_id": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        },
        "candidate_set_id": {
          "type": "string"
        },
        "data_version": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "dataset": {
              "const": "league"
            },
            "root": {
              "const": "data/league"
            },
            "source_commit": {
              "type": "string"
            },
            "dataset_version": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "snapshot_source": {
              "const": "generator_decisions"
            },
            "match_excluded_from_fitting": {
              "const": true
            }
